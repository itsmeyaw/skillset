{
  "name": "@itsmeyaw/skillset",
  "version": "0.2.1",
  "description": "Curate and install agent skills pinned to Git commits",
  "license": "MIT",
  "keywords": [
    "cli",
    "agent-skills",
    "skills",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "gemini-cli",
    "github-copilot",
    "universal"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/itsmeyaw/skillset.git"
  },
  "bin": {
    "skillset": "dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "schemas/skillset/v1.json"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "install:local": "pnpm build && npm link",
    "schema:generate": "node scripts/generate-schema.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "effect": "4.1.4",
    "skills": "1.8.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@effect/vitest": "4.1.4",
    "@types/node": "^22.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
