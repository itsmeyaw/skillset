  "maintainers": [
    {
      "name": "Yudhistira Arief Wibowo",
      "email": "yudhistira.wibowo@itsmeyaw.id",
      "url": "https://github.com/itsmeyaw"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/itsmeyaw/skillset.git"
  },
  "bin": {
    "skillset": "dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "schemas/skillset/v1.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint && husky",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "install:local": "pnpm build && npm link",
    "schema:generate": "node scripts/generate-schema.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "effect": "4.1.4",
    "jsonc-parser": "3.3.1",
    "skills": "1.9.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "4.1.4",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "oxlint --deny-warnings --fix",
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
