{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://raw.githubusercontent.com/itsmeyaw/skillset/main/schemas/skillset/v1.json"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\P{Cc}+$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\P{Cc}+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "required": [
          "name",
          "source",
          "commit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "skills"
  ],
  "additionalProperties": false,
  "title": "Skillset",
  "description": "A curated list of agent skills pinned to commits."
}
