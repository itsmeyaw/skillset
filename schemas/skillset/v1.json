{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://raw.githubusercontent.com/itsmeyaw/skillset/main/schemas/skillset/v1.json"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "not": {
                  "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                }
              }
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "not": {
                  "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                }
              }
            ]
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "required": [
          "name",
          "source",
          "commit"
        ],
        "additionalProperties": false
      }
    },
    "mcp": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "not": {
                  "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                }
              }
            ],
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "launch": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "package"
                    ]
                  },
                  "registryType": {
                    "type": "string",
                    "enum": [
                      "npm",
                      "pypi",
                      "nuget",
                      "oci"
                    ]
                  },
                  "identifier": {
                    "type": "string",
                    "minLength": 1,
                    "allOf": [
                      {
                        "not": {
                          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                        }
                      }
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "allOf": [
                      {
                        "not": {
                          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                        }
                      }
                    ],
                    "pattern": "^(?!.*(?:^|[.-])[xX*](?:[.-]|$))v?\\d[0-9A-Za-z.+!_-]*$"
                  },
                  "runtimeHint": {
                    "type": "string",
                    "minLength": 1,
                    "allOf": [
                      {
                        "not": {
                          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                        }
                      }
                    ]
                  },
                  "runtimeArguments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "allOf": [
                        {
                          "not": {
                            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                          }
                        }
                      ]
                    }
                  },
                  "packageArguments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "allOf": [
                        {
                          "not": {
                            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                          }
                        }
                      ]
                    }
                  },
                  "transport": {
                    "type": "string",
                    "enum": [
                      "stdio"
                    ]
                  }
                },
                "required": [
                  "type",
                  "registryType",
                  "identifier",
                  "version",
                  "transport"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "remote"
                    ]
                  },
                  "transport": {
                    "type": "string",
                    "enum": [
                      "streamable-http",
                      "sse"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "allOf": [
                      {
                        "not": {
                          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                        }
                      }
                    ],
                    "pattern": "^https:\\/\\/\\S+$"
                  },
                  "headers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "allOf": [
                            {
                              "not": {
                                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                              }
                            }
                          ],
                          "pattern": "^[A-Za-z0-9-]+$"
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "allOf": [
                            {
                              "not": {
                                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                              }
                            }
                          ]
                        }
                      },
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "type",
                  "transport",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "command"
                    ]
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "allOf": [
                      {
                        "not": {
                          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                        }
                      }
                    ]
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "allOf": [
                        {
                          "not": {
                            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                          }
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "command"
                ],
                "additionalProperties": false
              }
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "allOf": [
                    {
                      "not": {
                        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                      }
                    }
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "env",
                    "variable"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "allOf": [
                    {
                      "not": {
                        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                      }
                    }
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "secret": {
                  "type": "boolean"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "filepath"
                  ]
                },
                "default": {
                  "type": "string",
                  "minLength": 1,
                  "allOf": [
                    {
                      "not": {
                        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                      }
                    }
                  ]
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "allOf": [
                      {
                        "not": {
                          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                        }
                      }
                    ]
                  }
                },
                "env": {
                  "type": "string",
                  "minLength": 1,
                  "allOf": [
                    {
                      "not": {
                        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                      }
                    }
                  ],
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "origin": {
            "type": "object",
            "properties": {
              "registry": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "not": {
                      "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                    }
                  }
                ],
                "pattern": "^https:\\/\\/\\S+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "not": {
                      "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                    }
                  }
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "not": {
                      "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                    }
                  }
                ]
              }
            },
            "required": [
              "registry",
              "name",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "launch"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "skills"
  ],
  "additionalProperties": false,
  "title": "Skillset",
  "description": "A curated list of agent skills pinned to commits."
}
